    <!-- What each buddy says. Little Robot is deadpan and loves pancakes; Sloth talks slowly and calls himself a monkey. -->
    <string name="line_robot_home">Beep boop. That means hello.</string>
    <string name="line_robot_right">Correct. Pancakes for everyone!</string>
    <string name="line_robot_wrong">Boo hoo. Try again.</string>
    <string name="line_robot_win">Who wants pancakes?!</string>
    <string name="line_robot_gg">Good game. Pancakes make everything better.</string>
    <string name="line_robot_hint">Bright idea. Follow the arrow.</string>
    <string name="line_robot_think">Thinking… with pancake power.</string>
    <string name="line_magnus_home">Magnus the Magnificent is ready. Are you?</string>
    <string name="line_magnus_right">Magnificent move!</string>
    <string name="line_magnus_wrong">Even magic misses sometimes. Try again.</string>
    <string name="line_magnus_win">A magnificent win!</string>
    <string name="line_magnus_gg">Good game. Next time we paint a better plan.</string>
    <string name="line_magnus_hint">I have a magnificent idea!</string>
    <string name="line_magnus_think">Hmm. Let me think magnificently.</string>
    <string name="line_girl_home">Ready for a game?</string>
    <string name="line_girl_right">Yes! That’s the one!</string>
    <string name="line_girl_wrong">Oh no. Try again.</string>
    <string name="line_girl_win">You did it!</string>
    <string name="line_girl_gg">Good game! Let’s play again.</string>
    <string name="line_girl_hint">Ooh, I have an idea!</string>
    <string name="line_girl_think">Hmm, let me think.</string>
    <string name="line_princess_home">The board awaits, Your Majesty.</string>
    <string name="line_princess_right">Royally done!</string>
    <string name="line_princess_wrong">Sniff. Try again.</string>
    <string name="line_princess_win">Checkmate, by royal decree!</string>
    <string name="line_princess_gg">A royally good game.</string>
    <string name="line_princess_hint">A royal idea!</string>
    <string name="line_princess_think">Let me think, royally.</string>
    <string name="line_monkey_home">Ooh ooh! Play a game?</string>
    <string name="line_monkey_right">Ooh ooh, correct!</string>
    <string name="line_monkey_wrong">Waaah. Try again.</string>
    <string name="line_monkey_win">Banana party!</string>
    <string name="line_monkey_gg">Good game! Ooh ooh.</string>
    <string name="line_monkey_hint">Ooh! An idea!</string>
    <string name="line_monkey_think">Ooh… thinking.</string>
    <string name="line_sloth_home">My name is Sloth… and I’m a monkey. Play… chess?</string>
    <string name="line_sloth_right">Correct! Monkeys… are… clever.</string>
    <string name="line_sloth_wrong">Even… monkeys… miss. Try… again.</string>
    <string name="line_sloth_win">You… won! Monkey… dance.</string>
    <string name="line_sloth_gg">Good… game. Says… this… monkey.</string>
    <string name="line_sloth_hint">This… monkey… has… an idea.</string>
    <string name="line_sloth_think">Thinking… like… a monkey.</string>
    <string name="line_bob_home">I have counted 9,104,227 stars. Ready to play?</string>
    <string name="line_bob_right">Excellent move. I did not see that coming.</string>
    <string name="line_bob_wrong">I don’t know what that was. Try again.</string>
    <string name="line_bob_win">You won. Star count updated to 9,104,228.</string>
    <string name="line_bob_gg">Good game. I am already planning the rematch.</string>
    <string name="line_bob_hint">One eyebrow is up. I have an idea.</string>
    <string name="line_bob_think">Both eyebrows are exploring. Thinking.</string>
